# App
NEXT_PUBLIC_URL=http://localhost:3000

# Firebase Auth (client) — required for sign-in / sign-up
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nyxpulse.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nyxpulse
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=nyxpulse.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (server) — required for sessions, profiles, progress, certificates
# Easiest on Vercel: paste the entire service-account JSON as one line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"nyxpulse",...}
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or set these three individually instead:
FIREBASE_PROJECT_ID=nyxpulse
FIREBASE_CLIENT_EMAIL=
# Paste the full private key. On Vercel, keep \n escape sequences in one line.
FIREBASE_PRIVATE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: force Stripe Price IDs instead of inline price_data
STRIPE_REQUIRE_PRICE_IDS=false

# SMTP (required in production for transactional email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@nyxpulse.com
SMTP_FROM_NAME=NyxPulse
SMTP_REQUIRED=false
SMTP_TEST_TOKEN=

# Contact / leads
CONTACT_INBOX_EMAIL=sales@nyxpulse.com
CONTACT_LEADS_TOKEN=

# Instructor skill sign-off (at least one recommended in production)
# Comma-separated emails allowed to sign skill sheets without a PIN
NYXPULSE_INSTRUCTOR_EMAILS=
# Optional shared facility PIN for sign-off authorization
NYXPULSE_INSTRUCTOR_PIN=
# Or set Clerk publicMetadata.instructor=true on an instructor user

# Cron token for POST /api/refreshers/notify (header: x-refreshers-token)
REFRESHERS_CRON_TOKEN=

# Firebase (Firestore via Admin SDK for progress, certificates, leads)
# Easiest on Vercel: paste the entire service-account JSON as one line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"nyxpulse",...}
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or set these three individually instead:
FIREBASE_PROJECT_ID=nyxpulse
FIREBASE_CLIENT_EMAIL=
# Paste the full private key. On Vercel, keep \n escape sequences in one line.
FIREBASE_PRIVATE_KEY=

# Optional browser Firebase config (Analytics / future client features)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nyxpulse.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nyxpulse
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=nyxpulse.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
