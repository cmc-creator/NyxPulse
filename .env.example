# ============================================================================
# NyxPulse environment variables
# Copy to .env.local for development. Set production values in Vercel.
# /api/health reports launchReady / paymentsReady / instructorReady status.
# ============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public site origin. Used for Stripe redirect URLs, emails, sitemap/robots.
# MUST be your https domain in production — live-mode Stripe checkout refuses
# to start without an https URL here.
NEXT_PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Firebase web client (required for sign-in / sign-up UI)
# Firebase Console → Project settings → Your apps → Web app config
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nyxpulse.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nyxpulse
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional (Analytics / future client features)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=nyxpulse.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Firebase Admin (server — required for sessions, profiles, progress,
# certificates, enrollment). Same project as the web client.
# Provide ONE of the following shapes:
# 1) FIREBASE_SERVICE_ACCOUNT_JSON — entire service-account JSON on one line
# 2) FIREBASE_SERVICE_ACCOUNT_BASE64 — base64 of that JSON (safest on Vercel)
# 3) The three split vars below
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=nyxpulse
FIREBASE_CLIENT_EMAIL=
# Keep \n escape sequences when pasting on one line.
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Stripe (payments)
# ---------------------------------------------------------------------------
# Secret key (sk_live_... in production, sk_test_... for testing).
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint you register in the Stripe
# dashboard: https://<your-domain>/api/stripe/webhook
# Events needed: checkout.session.completed, charge.refunded,
# charge.dispute.created
STRIPE_WEBHOOK_SECRET=
# Optional: require Stripe Price IDs instead of inline price_data. When
# "true", each course needs STRIPE_PRICE_ID_<SLUG> (e.g.
# STRIPE_PRICE_ID_CPR_AED) or checkout returns an error.
STRIPE_REQUIRE_PRICE_IDS=false
# Optional: collect sales tax with Stripe Tax. Activate Tax in the Stripe
# dashboard FIRST — enabling this without activation breaks checkout.
STRIPE_AUTOMATIC_TAX=false

# ---------------------------------------------------------------------------
# SMTP transactional email (enrollment confirmations, certificates, team
# invites, contact form). Without SMTP_HOST/USER/PASS, emails soft-skip.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@nyxpulse.com
SMTP_FROM_NAME=NyxPulse
# When "true", /api/health-style checks treat missing SMTP as an error.
SMTP_REQUIRED=false
# Token protecting POST /api/test-email (header: x-smtp-test-token).
SMTP_TEST_TOKEN=

# ---------------------------------------------------------------------------
# Contact form / sales leads
# ---------------------------------------------------------------------------
# Inbox that receives contact-form notifications.
CONTACT_INBOX_EMAIL=sales@nyxpulse.com
# Token protecting GET /api/contact/leads (header: x-leads-token).
CONTACT_LEADS_TOKEN=

# ---------------------------------------------------------------------------
# Roles & access
# ---------------------------------------------------------------------------
# Comma-separated emails recognized as instructors (Jeremy's account).
# Instructors get read-only access to all course content and can record
# skill sign-offs. Alternative: Firebase custom claim { instructor: true }
# or learner-profile field instructor=true.
NYXPULSE_INSTRUCTOR_EMAILS=
# Optional shared facility PIN letting non-instructor accounts record
# skill sign-offs.
NYXPULSE_INSTRUCTOR_PIN=
# Comma-separated owner/admin emails. Accounts signed in with these emails
# are platform admins: they can grant client team/org plans
# (POST /api/admin/plan) and also get instructor-level course access.
NYXPULSE_ADMIN_EMAILS=
# Advanced alternative to NYXPULSE_ADMIN_EMAILS: a one-time token for the
# x-admin-bootstrap-token header on /api/auth/claims and /api/admin/plan.
# Only needed for scripted setups — most deployments can leave this empty.
NYXPULSE_ADMIN_BOOTSTRAP_TOKEN=

# ---------------------------------------------------------------------------
# Cron / ops
# ---------------------------------------------------------------------------
# Token for POST /api/refreshers/notify (header: x-refreshers-token) —
# scheduled refresher-training reminder emails.
REFRESHERS_CRON_TOKEN=

# ---------------------------------------------------------------------------
# Local file-store overrides (dev only — production uses Firestore when
# Firebase Admin is configured; these override the .data/*.json fallbacks)
# ---------------------------------------------------------------------------
# ORG_INVITES_STORAGE_PATH=
# SKILL_SIGNOFFS_STORAGE_PATH=
# DRILLS_STORAGE_PATH=
# CONTACT_LEADS_STORAGE_PATH=

# ---------------------------------------------------------------------------
# Firebase emulators (local development / testing only — never in production)
# Run: npx firebase-tools emulators:start --only auth,firestore --project demo-nyxpulse
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
